import { ComboBox, CheckBox, ScrollView, Slider } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Antigravity Voice Changer";
    min-width: 450px;
    min-height: 700px;
    background: #1e1e1e;

    callback toggle-audio();
    callback select-effect(int);
    callback select-input-device(string);
    callback select-output-device(string);
    callback select-monitor-device(string);
    callback toggle-monitor(bool);
    callback adjust-pitch(float);
    callback adjust-intensity(float);

    in-out property <bool> audio-active: false;
    in property <[string]> input-devices: ["Default"];
    in property <[string]> output-devices: ["Default"];
    in property <string> current-input: "Default";
    in property <string> current-output: "Default";
    in property <string> current-monitor: "Default";
    in-out property <bool> monitor-active: false;
    in property <int> selected-effect-index: 0;
    in-out property <float> pitch-value: 0.5;
    in-out property <float> intensity-value: 0.5;

    VerticalLayout {
        padding: 20px;
        spacing: 15px;

        Text {
            text: "Antigravity Voice Changer";
            color: #ffffff;
            font-size: 20px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        // Status Area
        HorizontalLayout {
            spacing: 10px;
            alignment: center;
            Text { text: "Status:"; color: #aaaaaa; }
            Text {
                text: audio-active ? "ACTIVE" : "INACTIVE";
                color: audio-active ? #4caf50 : #f44336;
                font-weight: 700;
            }
        }

        // Device Selection Section
        Rectangle {
            background: #252525;
            border-radius: 4px;
            VerticalLayout {
                padding: 10px;
                spacing: 10px;
                Text { text: "Audio Settings"; color: #ffffff; font-weight: 600; }
                
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        Text { text: "Input (Mic)"; color: #aaaaaa; font-size: 12px; }
                        ComboBox {
                            model: input-devices;
                            current-value: current-input;
                            selected(val) => { select-input-device(val) }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        Text { text: "Primary Output (e.g. Virtual Cable)"; color: #aaaaaa; font-size: 12px; }
                        ComboBox {
                            model: output-devices;
                            current-value: current-output;
                            selected(val) => { select-output-device(val) }
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        Text { text: "Self Monitoring (Headphones)"; color: #aaaaaa; font-size: 12px; }
                        ComboBox {
                            model: output-devices;
                            current-value: current-monitor;
                            selected(val) => { select-monitor-device(val) }
                        }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;
                        CheckBox {
                            text: "Enable Monitoring";
                            checked: monitor-active;
                            toggled => { monitor-active = !monitor-active; toggle-monitor(monitor-active) }
                        }
                    }
                    Text {
                        text: "Tip: To route to a game without hearing yourself, set Primary Output to a Virtual Cable and uncheck Enable Monitoring.";
                        color: #888888;
                        font-size: 10px;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // Processing Toggle
        Rectangle {
            height: 40px;
            background: audio-active ? #2a3a2a : #252525;
            border-radius: 4px;
            border-width: 1px;
            border-color: #444444;
            TouchArea { clicked => { toggle-audio() } }
            Text { text: "Toggle Audio Processing"; color: #ffffff; }
        }

        // Voice Tuning
        Rectangle {
            background: #252525;
            border-radius: 4px;
            VerticalLayout {
                padding: 10px;
                spacing: 8px;
                Text { text: "Voice Tuning"; color: #ffffff; font-weight: 600; }
                
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        Text { text: "Pitch / Frequency"; color: #aaaaaa; font-size: 11px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: Math.round(pitch-value * 100) + "%"; color: #aaaaaa; font-size: 11px; }
                    }
                    Slider {
                        value: pitch-value;
                        changed(val) => { pitch-value = val; adjust-pitch(val) }
                    }
                }

                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        Text { text: "Modulation Strength"; color: #aaaaaa; font-size: 11px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: Math.round(intensity-value * 100) + "%"; color: #aaaaaa; font-size: 11px; }
                    }
                    Slider {
                        value: intensity-value;
                        changed(val) => { intensity-value = val; adjust-intensity(val) }
                    }
                }
            }
        }

        // Effects Selection with ScrollView
        Text { text: "Select Effect"; color: #ffffff; font-weight: 600; }
        
        ScrollView {
            height: 250px;
            VerticalLayout {
                spacing: 8px;
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 0 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(0) } }
                        Text { text: "None"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 1 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(1) } }
                        Text { text: "Robot"; color: #fff; }
                    }
                }
                
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 2 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(2) } }
                        Text { text: "Megaphone"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 3 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(3) } }
                        Text { text: "Deep"; color: #fff; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 4 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(4) } }
                        Text { text: "High"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 5 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(5) } }
                        Text { text: "Echo"; color: #fff; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 6 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(6) } }
                        Text { text: "Alien"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 7 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(7) } }
                        Text { text: "Radio"; color: #fff; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 8 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(8) } }
                        Text { text: "Demon"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 9 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(9) } }
                        Text { text: "Little Kid"; color: #fff; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 10 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(10) } }
                        Text { text: "CB Radio"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 11 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(11) } }
                        Text { text: "Astronaut"; color: #fff; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 12 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(12) } }
                        Text { text: "Telephone"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 13 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(13) } }
                        Text { text: "Monster"; color: #fff; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 14 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(14) } }
                        Text { text: "Chipmunk"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 15 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(15) } }
                        Text { text: "Vader"; color: #fff; }
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 16 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(16) } }
                        Text { text: "Ghost"; color: #fff; }
                    }
                    Rectangle { 
                        height: 35px; background: selected-effect-index == 17 ? #4a90e2 : #333; border-radius: 4px;
                        TouchArea { clicked => { select-effect(17) } }
                        Text { text: "Cyberpunk"; color: #fff; }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; }
        Text { text: "v0.1.0-beta"; color: #555555; font-size: 11px; horizontal-alignment: center; }
    }
}
